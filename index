<script>
// Use a Blob URL so embedded PDF downloads also work in embedded browsers.
document.querySelectorAll('a[download]').forEach(link => {
  link.addEventListener('click', event => {
    if (!link.href.startsWith('data:application/pdf;base64,')) return;
    event.preventDefault();
    const bytes = Uint8Array.from(atob(link.href.split(',')[1]), c => c.charCodeAt(0));
    const url = URL.createObjectURL(new Blob([bytes], {type: 'application/pdf'}));
    const download = document.createElement('a');
    download.href = url;
    download.download = 'Khalid-Alvi-Evan-CV.pdf';
    document.body.appendChild(download);
    download.click();
    download.remove();
    setTimeout(() => URL.revokeObjectURL(url), 60000);
  });
});

document.documentElement.classList.add('js');
const menu=document.querySelector('.menu'),nav=document.querySelector('nav');
